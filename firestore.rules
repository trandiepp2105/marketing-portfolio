rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isPortfolioAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }

    match /admins/{adminId} {
      // A signed-in user can check their own authorization document only.
      // Admin documents can only be provisioned from Firebase Console/Admin SDK.
      allow get: if request.auth != null && request.auth.uid == adminId;
      allow list, create, update, delete: if false;
    }

    match /brands/{brandId} {
      allow read: if true;
      allow create, update, delete: if isPortfolioAdmin();
    }

    match /projects/{projectId} {
      allow read: if true;
      allow create, update, delete: if isPortfolioAdmin();
    }

    match /contact/{contactId} {
      allow read: if true;
      allow create, update, delete: if isPortfolioAdmin();
    }

    match /profile/{profileId} {
      allow read: if true;
      allow create, update, delete: if isPortfolioAdmin();
    }

    match /settings/{settingId} {
      allow read, write: if isPortfolioAdmin();
    }
  }
}
